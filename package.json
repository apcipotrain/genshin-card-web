{
  "name": "genshin-card-web",
  "version": "2.0.0",
  "description": "原神杀 - 网页版杀牌游戏（支持PVE和PVP联机）",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc --noEmit && tsc -p server/tsconfig.json --noEmit",
    "test": "node --import tsx --test tests/GameSession.test.ts tests/BackgroundAssets.test.ts tests/ChatService.test.ts tests/AccountApiClient.test.ts tests/PvpSettlementQueue.test.ts tests/BattleInteractions.test.ts tests/EquipEffectManager.test.ts",
    "test:backend:smoke": "node scripts/smoke-backend.mjs",
    "test:game:stress": "node --import tsx scripts/stress-games.ts",
    "preview": "vite preview",
    "server": "node scripts/game-server.mjs",
    "backend": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/java-backend.ps1 -Task run",
    "backend:test": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/java-backend.ps1 -Task test",
    "backend:package": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/java-backend.ps1 -Task package",
    "start": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/dev.ps1"
  },
  "dependencies": {
    "express": "^4.21.0",
    "socket.io": "^4.7.5",
    "socket.io-client": "^4.7.5"
  },
  "devDependencies": {
    "@types/node": "^25.9.3",
    "concurrently": "^9.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.4.0",
    "vite": "^5.4.0"
  }
}
